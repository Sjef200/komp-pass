{
  "name": "mfl-ovingsapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mcp": "tsx mcp/src/server.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector ./node_modules/.bin/tsx mcp/src/server.ts",
    "test": "MFL_DB=\"${TMPDIR:-/tmp}/mfl-test-$$.db\" tsx --test src/lib/*.test.ts",
    "fetch:udir": "tsx scripts/fetch-udir.ts",
    "migrer": "tsx scripts/migrer-til-sqlite.ts",
    "transkriber": "tsx scripts/transkriber.ts",
    "indekser": "tsx scripts/indekser-kilde.ts",
    "bygg:plugin": "tsx scripts/bygg-plugin.ts",
    "logg-inn": "tsx scripts/logg-inn.ts",
    "mcp:http": "tsx mcp/src/http-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
